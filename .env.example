# Keep these values server-side. Do not use NEXT_PUBLIC_ for credential-bearing values.
SOLANA_NETWORK=devnet
SOLANA_RPC_URL=https://your-devnet-rpc.example
PYTH_API_KEY=replace-with-your-pyth-pro-api-key

# Exact verified identities for the one curated Devnet Market. Do not use guessed values.
BAZO_MARKET_ID=your-market-id
BAZO_MARKET_SYMBOL=your-symbol
BAZO_MARKET_NAME=your-market-name
BAZO_STOCK_MINT=your-stock-mint
BAZO_STOCK_TOKEN_PROGRAM=TokenzQdBNbLqP5VEhdkhQmUoNrvqT4GQbKB3B6hY2e
BAZO_QUOTE_MINT=your-quote-mint
BAZO_QUOTE_TOKEN_PROGRAM=TokenzQdBNbLqP5VEhdkhQmUoNrvqT4GQbKB3B6hY2e
BAZO_QUOTE_SYMBOL=USDC
BAZO_TOKEN_DECIMALS=6
BAZO_SUPPORTED_EXTENSIONS=scaledUiAmount
BAZO_PYTH_FEED_ID=your-verified-pyth-feed-id
BAZO_ALLOWED_SESSIONS=regular
BAZO_MAX_REFERENCE_AGE_SECONDS=90
BAZO_MIN_PUBLISHER_COUNT=1
BAZO_MAX_CONFIDENCE_RATIO_BPS=100
BAZO_MINIMUM_STAGE_RAW_AMOUNT=1
BAZO_BATCH_DURATION_SECONDS=300
