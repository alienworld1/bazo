# Keep these values server-side. Do not use NEXT_PUBLIC_ for credential-bearing values.
SOLANA_NETWORK=devnet
SOLANA_RPC_URL=https://your-devnet-rpc.example
PYTH_API_KEY=replace-with-your-pyth-pro-api-key
BAZO_PROGRAM_ID=your-deployed-bazo-program-id

# Exact verified identities for the one curated Devnet Market. Do not use guessed values.
BAZO_MARKET_ID=your-market-id
BAZO_MARKET_SYMBOL=your-symbol
BAZO_MARKET_NAME=your-market-name
BAZO_STOCK_MINT=your-stock-mint
BAZO_STOCK_TOKEN_PROGRAM=TokenzQdBNbLqP5VEhdkAS6EPFLC1PHnBqCXEpPxuEb
BAZO_QUOTE_MINT=your-quote-mint
BAZO_QUOTE_TOKEN_PROGRAM=TokenzQdBNbLqP5VEhdkAS6EPFLC1PHnBqCXEpPxuEb
BAZO_QUOTE_SYMBOL=USDC
BAZO_TOKEN_DECIMALS=6
BAZO_SUPPORTED_EXTENSIONS=ScaledUiAmountConfig
BAZO_PYTH_FEED_ID=1435
BAZO_ALLOWED_SESSIONS=regular
BAZO_MAX_REFERENCE_AGE_SECONDS=90
BAZO_MIN_PUBLISHER_COUNT=1
BAZO_MAX_CONFIDENCE_RATIO_BPS=100
BAZO_MINIMUM_STAGE_RAW_AMOUNT=1
BAZO_BATCH_DURATION_SECONDS=45
BAZO_BATCH_LOCK_SECONDS=120
BAZO_COORDINATOR_URL=http://127.0.0.1:3145/
BAZO_COORDINATOR_PORT=3145
BAZO_COORDINATOR_SECRET=replace-with-an-independent-strong-random-secret
BAZO_COORDINATOR_FEE_PAYER_PATH=/absolute/path/to/devnet-fee-payer.json

# Required only when enabling private-copy persistence. This directory must be
# outside public assets and owned by the application process.
BAZO_PRIVATE_BLOB_DIRECTORY=/absolute/path/to/private-bazo-blobs
# Generate a random value of at least 32 characters; never expose it to clients.
BAZO_AUTH_SESSION_SECRET=replace-with-a-strong-random-secret
